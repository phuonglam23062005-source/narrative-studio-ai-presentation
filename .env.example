# Public/local configuration only. Never put real secrets in this file.
APP_ENV=local
PUBLIC_DEFAULT_LOCALE=vi
PUBLIC_LOCAL_ONLY=true

# Public Google Identity Services client ID. This is not a secret.
PUBLIC_GOOGLE_CLIENT_ID=
# Same-origin/server endpoint that verifies the Google ID token and returns the app user + role.
PUBLIC_GOOGLE_VERIFY_ENDPOINT=/api/auth/google
# Local preview only; never use a client-side allowlist as production authorization.
PUBLIC_LOCAL_ADMIN_EMAILS=

# Server-side Google verification and signed session configuration for Vercel.
GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_EMAILS=
AUTH_SESSION_SECRET=

# Server-side adapters for future phases. Leave empty until the adapter is implemented.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
